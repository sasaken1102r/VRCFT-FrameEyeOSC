<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FrameEyeOSC</AssemblyName>
    <RootNamespace>FrameEyeOSC</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>FrameEyeOSC</Product>
    <Description>VRCFaceTracking module for Steam Frame eye tracking via frameeyeosc.</Description>
    <Authors>sasaken@</Authors>
    <Copyright>Copyright (c) 2026 sasaken1102r</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The icon travels inside the DLL; VRCFT reads it from ModuleInformation.StaticImages. -->
    <EmbeddedResource Include="Assets\frameeyeosc-256.png" LogicalName="FrameEyeOSC.Assets.frameeyeosc-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- VRCFT's module process provides this at runtime; class libraries don't copy package DLLs to the output. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- VRCFT loads its own copies; Private=false keeps them out of the build output. -->
    <Reference Include="VRCFaceTracking.Core">
      <HintPath>../refs/VRCFaceTracking.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VRCFaceTracking.SDK">
      <HintPath>../refs/VRCFaceTracking.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrameEyeOSC.Tests" />
  </ItemGroup>

</Project>
